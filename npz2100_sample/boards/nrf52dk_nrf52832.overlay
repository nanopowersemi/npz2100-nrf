&arduino_i2c {
	status = "okay";

	/*
	 * 100 kHz — nPZ2100 maximum rated I²C frequency.
	 * The nRF52840 TWIM peripheral maps I2C_BITRATE_STANDARD to 100 kHz.
	 */
	clock-frequency = <I2C_BITRATE_STANDARD>;

	npz2100: npz2100@3C {
		compatible = "nanopower,npz2100";
		reg = <0x3C>;        /* 7-bit I²C address — adjust if strapped differently */
		label = "NPZ2100";
	};
};

&pinctrl {
	uart0_default: uart0_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 6)>;
		};
	};

	uart0_sleep: uart0_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 6)>;
			low-power-enable;
		};
	};
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-1 = <&uart0_sleep>;
	pinctrl-names = "default", "sleep";
};

